export PATH=$PATH:$HOME/.local/bin/

if ! test -f ~/.local/bin/getnf; then
	curl -fsSL https://raw.githubusercontent.com/getnf/getnf/main/install.sh | bash -s -- --silent
fi

# Check if Hack font is installed using fc-list
if ! fc-list | grep -i "Hack Nerd Font Mono" > /dev/null; then
    echo "Hack font not found. Installing..."
    getnf -iHack
fi

export PS1='\[\033[0;32m\][\u@\h \W]\$\[\033[0m\] '

alias gitf='GIT_SSH_COMMAND="ssh -o IdentityAgent=SSH_AUTH_SOCK" git'

export ANDROID_HOME=/home/bjorn/Android/Sdk
export PATH=$PATH:$ANDROID_HOME/platform-tools


# Start Hyprland on TTY1 login; exec so a crash ends the session instead of leaving a shell
if [ -z "$WAYLAND_DISPLAY" ] && [ "$XDG_VTNR" = 1 ] && [ "$XDG_SESSION_TYPE" = tty ]; then
    exec start-hyprland
fi
